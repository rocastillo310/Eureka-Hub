{
	// Worker único: sirve public/ y las rutas /api.
	// La cuenta se toma de CLOUDFLARE_ACCOUNT_ID (no se escribe aquí).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eureka-hub",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": { "enabled": true },

	"vars": {
		// Tamaño máximo por archivo entregado (F2). 4 GB, confirmado por Rodrigo el 12 oct 2026.
		"MAX_ARCHIVO_MB": "4096",
		// Repo PRIVADO de los respaldos (F5). El token va como secreto: GITHUB_TOKEN_RESPALDO.
		"RESPALDO_REPO": "rocastillo310/eureka-hub-backups",
		// Único usuario del Hub que ve el respaldo y recibe sus avisos (id de usuario, no correo).
		"RESPALDO_DUENO": "rodrigo"
	},

	// Respaldo diario (F5). Los Cron Triggers usan UTC: 09:00 UTC = 3:00 a. m. en Guadalajara (UTC-6, sin horario de verano).
	"triggers": { "crons": ["0 9 * * *"] },

	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// /api y el panel /admin siempre pasan por el Worker; lo demás son archivos estáticos.
		"run_worker_first": ["/api/*", "/admin", "/admin/*"]
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eureka-hub-db",
			"database_id": "4f8ebaa4-af26-4a82-9664-1843fcc31487",
			"migrations_dir": "migrations"
		}
	],

	// Bucket privado: sin dominio público ni r2.dev. Toda descarga pasa por el Worker.
	"r2_buckets": [
		{
			"binding": "ENTREGAS",
			"bucket_name": "eureka-hub-entregas"
		}
	]
}
